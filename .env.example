# Copy to .env and adjust for your environment.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/online_food_kitchen

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=5

# Vendor uploads (local storage; swap for S3-compatible storage in production)
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Vendor payouts ("today" metrics use Rwanda time by default)
# Commission is taken from the food subtotal only (never the delivery fee).
PLATFORM_COMMISSION_PERCENT=15
TZ_OFFSET_HOURS=2

# Order defaults
AGENT_API_KEY=dev-agent-key

# Driver dispatch & delivery fee model
DELIVERY_OFFER_TIMEOUT_SECONDS=45
DELIVERY_RADIUS_KM=8
DELIVERY_MAX_ACTIVE=3
# The customer pays by road distance from the kitchen to the drop-off:
#   fee = max(DELIVERY_MIN_FEE_RWF, DELIVERY_BASE_FEE_RWF + DELIVERY_PER_KM_FEE_RWF * km)
DELIVERY_BASE_FEE_RWF=500
DELIVERY_PER_KM_FEE_RWF=200
DELIVERY_MIN_FEE_RWF=800
# Without a Google key, road km = straight-line km * DELIVERY_ROAD_FACTOR.
DELIVERY_ROAD_FACTOR=1.3

# Google Maps (server-side key with the Routes API enabled). When set, the
# delivery fee uses real road distance; leave empty to use the estimate above.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TRAVEL_MODE=DRIVE
# Drivers keep 100% of the delivery fee (no platform commission).
DELIVERY_DRIVER_SHARE_PERCENT=100

# Customer notifications (delivery confirmation code)
# Leave SMS_* empty to log messages to the console instead of sending.
SMS_ENABLED=false
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_API_KEY_HEADER=
SMS_SENDER_ID=FoodKitchen

# Owner (super admin) commission withdrawals. Money actions need an SMS code
# (turn on SMS codes in Admin > Settings) and a non-default admin password.
OWNER_MAX_WITHDRAWAL_RWF=500000
OWNER_MAX_WEEKLY_RWF=2000000
OWNER_RESERVE_PERCENT=10
OWNER_DESTINATION_COOLDOWN_HOURS=48
# Weekly sweep reminder (Kigali time; weekday 0=Sun ... 5=Fri).
OWNER_SWEEP_ENABLED=true
OWNER_SWEEP_WEEKDAY=5
OWNER_SWEEP_HOUR=9
OWNER_SWEEP_MIN_RWF=5000
ADMIN_OTP_TTL_MINUTES=5
# Service that sends owner payouts automatically. 'manual' (default): the
# system creates the withdrawal on schedule and the owner transfers it.
PAYOUT_PROVIDER=manual
