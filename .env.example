# Copy to .env and adjust for your environment.
NODE_ENV=development
PORT=4000
# Databases. On a live server both are required and must include a username
# and password (the server refuses to start otherwise), e.g.
#   MONGODB_URI=mongodb://kitchenlink:<password>@127.0.0.1:27017/online_food_kitchen?authSource=admin
#   PG_URI=postgresql://kitchenlink:<password>@127.0.0.1:5432/online_food_kitchen
# Also keep both databases unreachable from the internet (listen on 127.0.0.1
# or a private network only). Without a password is fine on your own PC.
MONGODB_URI=mongodb://127.0.0.1:27017/online_food_kitchen

# Websites allowed to call this API from a browser (comma-separated exact
# origins). Defaults to FRONTEND_URL. Example for a live server:
#   ALLOWED_ORIGINS=https://kitchenlink.rw,https://www.kitchenlink.rw
# Required on a live server: the real addresses (not localhost).
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Behind a hosting proxy / load balancer (nginx, Render, Heroku...): how many
# proxies sit in front of the API, so per-IP limits see real visitors. Leave
# empty when the API is reached directly.
TRUST_PROXY=

# Per-IP request limits (per minute): the whole API, and the public delivery
# price check (it may call the paid Google Routes API).
API_RATE_MAX_PER_MINUTE=600
DELIVERY_QUOTE_RATE_MAX_PER_MINUTE=30

# Auth
# Required on a live server: a random string of 32+ characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start with a missing, placeholder or short secret
# unless NODE_ENV is development or test.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# First admin account, created when the database has none. On a live server
# ADMIN_SEED_PASSWORD is required (12+ characters, not the example one); the
# admin must change it at first sign-in anyway.
ADMIN_SEED_EMAIL=admin@foodkitchen.rw
ADMIN_SEED_PASSWORD=
OTP_TTL_MINUTES=5

# Vendor uploads (local storage; swap for S3-compatible storage in production)
# Required on a live server: the API's public address (photo links use it).
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Vendor payouts ("today" metrics use Rwanda time by default)
# Commission is taken from the food subtotal only (never the delivery fee).
PLATFORM_COMMISSION_PERCENT=15
TZ_OFFSET_HOURS=2

# Order defaults
# Unlocks internal endpoints that change order status. Required on a live
# server: a private random string of 32+ characters (not this example).
AGENT_API_KEY=dev-agent-key

# Driver dispatch & delivery fee model
DELIVERY_OFFER_TIMEOUT_SECONDS=45
# Starting values; admins change them in Settings → Delivery & pickup rules.
DELIVERY_RADIUS_KM=8
DELIVERY_MAX_ACTIVE=3
# How long the customer's delivery confirmation code works (hours). The code
# goes only to the customer's verified email (or SMS once a gateway is set up).
DELIVERY_CODE_VALID_HOURS=12
# The customer pays by road distance from the kitchen to the drop-off:
#   fee = max(DELIVERY_MIN_FEE_RWF, DELIVERY_BASE_FEE_RWF + DELIVERY_PER_KM_FEE_RWF * km)
DELIVERY_BASE_FEE_RWF=500
DELIVERY_PER_KM_FEE_RWF=200
DELIVERY_MIN_FEE_RWF=800
# Without a Google key, road km = straight-line km * DELIVERY_ROAD_FACTOR.
DELIVERY_ROAD_FACTOR=1.3

# Google Maps (server-side key with the Routes API enabled). When set, the
# delivery fee uses real road distance; leave empty to use the estimate above.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TRAVEL_MODE=DRIVE
# Standard delivery fee per meter: fee = base + road meters x rate (e.g.
# 500 + 2,000 m x 0.3 = 1,100 RWF). Starting values until an admin saves their
# own in Settings -> Delivery fee by distance. Needs a real road distance
# (ROUTING_PROVIDER below). MAX empty = no maximum; MIN is at least 500.
DELIVERY_PER_METER_ENABLED=false
DELIVERY_PER_METER_BASE_FEE_RWF=500
DELIVERY_PER_METER_RWF=0.3
DELIVERY_PER_METER_MIN_FEE_RWF=500
DELIVERY_PER_METER_MAX_FEE_RWF=
# Big-event delivery (the kitchen delivers a catering order), separate from the
# standard fee: fee = starting fee + road meters x rate, at least the minimum.
# Above the automatic ceiling nothing is charged automatically: the customer
# requests a special delivery and accepts a kitchen's quotation. Starting
# values until an admin saves Delivery Management -> Big-event delivery pricing.
BIG_EVENT_DELIVERY_STARTING_FEE_RWF=3000
BIG_EVENT_DELIVERY_PER_METER_RWF=0.5
BIG_EVENT_DELIVERY_MIN_FEE_RWF=3000
BIG_EVENT_DELIVERY_AUTO_CEILING_RWF=40000
BIG_EVENT_QUOTATION_VALIDITY_HOURS=48
# Road distance for delivery prices: auto (Google when GOOGLE_MAPS_API_KEY is
# set, then OSRM) | google | osrm | none (straight-line estimate; per-meter
# pricing then refuses delivery). OSRM_URL picks the OSRM server; the public
# one is for light use, so run your own for real traffic and set
# OSRM_MIN_INTERVAL_MS=0 (the public server asks for ~1 request per second).
ROUTING_PROVIDER=auto
ROUTING_TIMEOUT_MS=5000
OSRM_MIN_INTERVAL_MS=1000
# Drivers keep 100% of the delivery fee (no platform commission).
DELIVERY_DRIVER_SHARE_PERCENT=100
# Late-pickup penalty: the share of the delivery fee the platform keeps when a
# driver collects a ready order late. It comes out of that order's fee only.
# Admins change it in Settings (0 = off).
DELIVERY_LATE_PENALTY_PERCENT=20

# Email: only used for team invitations. Optional: without it (or if sending
# fails) the owner sees the invitation link on the Team page to share by
# WhatsApp/SMS, and on a development server the email is printed in the
# console. The server checks the setup at startup and logs problems.
# Choose ONE delivery method (uncomment and fill in):
#  a) HTTP email API — resend | sendgrid | mailgun | brevo
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# Optional endpoint override (Mailgun domain, self-hosted API, region):
# EMAIL_API_URL=
#  b) SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=KitchenLink <no-reply@foodkitchen.rw>

# Customer notifications (delivery confirmation code)
# Leave SMS_* empty to log messages to the console instead of sending.
SMS_ENABLED=false
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_API_KEY_HEADER=
SMS_SENDER_ID=FoodKitchen

# Owner (super admin) commission withdrawals. Money actions need an SMS code
# (turn on SMS codes in Admin > Settings) and a non-default admin password.
OWNER_MAX_WITHDRAWAL_RWF=500000
OWNER_MAX_WEEKLY_RWF=2000000
OWNER_RESERVE_PERCENT=10
OWNER_DESTINATION_COOLDOWN_HOURS=48
# Weekly sweep reminder (Kigali time; weekday 0=Sun ... 5=Fri).
OWNER_SWEEP_ENABLED=true
OWNER_SWEEP_WEEKDAY=5
OWNER_SWEEP_HOUR=9
OWNER_SWEEP_MIN_RWF=5000
ADMIN_OTP_TTL_MINUTES=5
# Admin sessions: signed out after this many minutes without use (0 = off).
ADMIN_IDLE_TIMEOUT_MINUTES=30
# Service that sends owner payouts automatically. 'manual' (default): the
# system creates the withdrawal on schedule and the owner transfers it.
PAYOUT_PROVIDER=manual

# Support contact shown to suspended/rejected vendors when login is blocked.
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Advanced (optional). Every value below is the built-in default, so the
# project runs the same with or without them; listed here so all settings
# the backend reads are in one place.
# ---------------------------------------------------------------------------
# Admin
ADMIN_SEED_NAME=Platform Admin
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_RATE_WINDOW_MS=60000
ADMIN_RATE_MAX=300
PAYOUT_FEE_RWF=0
LARGE_MONEY_ACTION_RWF=50000
TEAM_INVITE_VALID_HOURS=72
REFUND_EXPECTED_HOURS=24

# Mailgun only: sending domain (defaults to the domain of MAIL_FROM)
MAILGUN_DOMAIN=

# Search radius for kitchens (km)
DEFAULT_RADIUS_KM=5
MAX_RADIUS_KM=50
FEED_RADIUS_KM=10
NEAR_YOU_RADIUS_KM=5

# Maps / geocoding (free OpenStreetMap services when no Google key is set)
GOOGLE_MAPS_TIMEOUT_MS=4000
GOOGLE_MAPS_CACHE_TTL_SECONDS=600
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=KitchenLink/1.0 (kitchen location search)
GEOCODER_COUNTRY=rw
GEOCODER_TIMEOUT_MS=6500

# Delivery dispatch details
DELIVERY_LOCATION_MAX_AGE_MINUTES=60
DELIVERY_MAX_OFFER_RECIPIENTS=50
DELIVERY_PICKUP_GRACE_MINUTES=15
DELIVERY_PICKUP_WARNING_MINUTES=10
DELIVERY_PICKUP_REASSIGN_MINUTES=30
DELIVERY_DISPATCH_TICK_SECONDS=60
DELIVERY_PLATFORM_MAX_KM=30

# Scheduled orders, specials and offer days
SCHEDULE_MIN_LEAD_MINUTES=45
SCHEDULE_MAX_DAYS_AHEAD=7
SCHEDULE_READY_WINDOW_MINUTES=60
SPECIAL_MAX_DAYS_AHEAD=14
OFFER_MAX_DAYS_AHEAD=60
OFFER_MAX_UPCOMING=3
OFFER_REMINDER_HOUR=9

# Uploads (private = vendor/driver documents)
PRIVATE_UPLOAD_DIR=private-uploads
UPLOAD_DOC_MAX_MB=10

# Mobile money (MTN MoMo + Airtel Money) through Paypack (https://paypack.rw).
# Without the client id/secret, payments are simulated (development only).
# Register <PUBLIC_BASE_URL>/api/v1/payments/paypack/webhook in the Paypack dashboard.
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_BASE_URL=https://payments.paypack.rw/api
# "development" or "production": Paypack calls the webhook registered for this mode.
PAYPACK_WEBHOOK_MODE=
