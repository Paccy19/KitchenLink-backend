igikoni.online, www.igikoni.online {
    encode gzip

    @api path /api /api/*
    handle @api {
        reverse_proxy host.docker.internal:4000
    }

    @uploads path /uploads /uploads/*
    handle @uploads {
        reverse_proxy host.docker.internal:4000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

mvec.igikoni.online {
    encode gzip

    @api path /api /api/*
    handle @api {
        reverse_proxy host.docker.internal:4100
    }

    @uploads path /uploads /uploads/*
    handle @uploads {
        reverse_proxy host.docker.internal:4100
    }

    @health path /health
    handle @health {
        reverse_proxy host.docker.internal:4100
    }

    handle {
        root * /srv-mvec
        try_files {path} /index.html
        file_server
    }
}

