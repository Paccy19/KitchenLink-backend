# KitchenLink API — production settings.
# Copy to deploy/backend.env on the server (gitignored) and fill in every CHANGE_ME.
# The API refuses to start while a required value is missing or a placeholder
# (see src/config/startupCheck.js); `docker compose logs backend` lists them all.
#
# Set by docker-compose.prod.yml (do NOT set them here):
#   NODE_ENV=production, PORT=4000, MONGODB_URI, PG_URI, UPLOAD_DIR, PRIVATE_UPLOAD_DIR
#
# Generate secrets with:   openssl rand -hex 48
#   or on Windows:         node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Addresses (REQUIRED) --------------------------------------------------
# Website address: invitation links + CORS.
FRONTEND_URL=https://igikoni.online
# Exact browser origins allowed to call the API (www only redirects, but is
# listed so nothing breaks if someone lands on it before the redirect).
ALLOWED_ORIGINS=https://igikoni.online,https://www.igikoni.online
# The API's public address: photo links are built from it.
PUBLIC_BASE_URL=https://api.igikoni.online
# One proxy (Caddy) sits in front of the API: per-IP rate limits see real visitors.
TRUST_PROXY=1

# --- Secrets (REQUIRED, 32+ random characters each) ------------------------
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=30d
# Unlocks internal endpoints that change order status. Keep private.
AGENT_API_KEY=CHANGE_ME

# --- First admin (REQUIRED on first start) ---------------------------------
# Created only when the database has no admin. 12+ characters; the admin must
# change it at first sign-in anyway.
ADMIN_SEED_EMAIL=admin@igikoni.online
ADMIN_SEED_PASSWORD=CHANGE_ME
ADMIN_SEED_NAME=Platform Admin

# --- SMS gateway (REQUIRED: customers, kitchens and drivers sign in with SMS codes)
# The API POSTs JSON to SMS_API_URL:
#   { "to": "+2507XXXXXXXX", "from": "<SMS_SENDER_ID>", "message": "<text>" }
# The key goes in the header named SMS_API_KEY_HEADER (e.g. Authorization or
# X-API-Key); if that is empty it is sent as "api_key" in the JSON body.
# Any 2xx response counts as sent. Your provider must accept this format (or
# put a small adapter in front of it) — see DEPLOYMENT.md "SMS and payments".
# Left empty on purpose: the API refuses to start until both are filled in.
SMS_ENABLED=true
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
SMS_API_KEY_HEADER=
SMS_SENDER_ID=KitchenLink
OTP_TTL_MINUTES=5

# --- Email (optional: team invitations; without it the owner shares the link)
# a) HTTP API: resend | sendgrid | mailgun | brevo
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_API_URL=
MAILGUN_DOMAIN=
# b) or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KitchenLink <no-reply@igikoni.online>

# --- Maps (optional but recommended for production traffic) ---------------
# Server-side Google key with the Routes API enabled. Without it the free
# public OpenStreetMap servers are used, which are not meant for production load.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TRAVEL_MODE=DRIVE
# Standard delivery fee per meter: fee = base + road meters x rate (e.g.
# 500 + 2,000 m x 0.3 = 1,100 RWF). Starting values until an admin saves their
# own in Settings -> Delivery fee by distance. Needs a real road distance
# (ROUTING_PROVIDER below). MAX empty = no maximum; MIN is at least 500.
DELIVERY_PER_METER_ENABLED=true
DELIVERY_PER_METER_BASE_FEE_RWF=500
DELIVERY_PER_METER_RWF=0.3
DELIVERY_PER_METER_MIN_FEE_RWF=500
DELIVERY_PER_METER_MAX_FEE_RWF=
# Road distance for delivery prices: auto (Google when GOOGLE_MAPS_API_KEY is
# set, then OSRM) | google | osrm | none (straight-line estimate; per-meter
# pricing then refuses delivery). OSRM_URL picks the OSRM server; the public
# one is for light use, so run your own for real traffic and set
# OSRM_MIN_INTERVAL_MS=0 (the public server asks for ~1 request per second).
ROUTING_PROVIDER=auto
ROUTING_TIMEOUT_MS=5000
OSRM_MIN_INTERVAL_MS=1000
# OpenStreetMap asks for an identifying User-Agent with a contact address.
GEOCODER_USER_AGENT=KitchenLink/1.0 (https://igikoni.online)

# --- Support contact shown to customers and blocked vendors ---------------
SUPPORT_PHONE=
SUPPORT_EMAIL=

# --- Payments --------------------------------------------------------------
# No payment provider is integrated yet: checkout answers
# "PAYMENTS_NOT_CONFIGURED" on a production server until one is.
# (Not a setting: it needs code — see DEPLOYMENT.md "SMS and payments".)
# Owner payouts: 'manual' = the system creates the withdrawal, the owner transfers it.
PAYOUT_PROVIDER=manual

# --- Business rules (starting values; admins change most in Settings) -----
API_RATE_MAX_PER_MINUTE=600
DELIVERY_QUOTE_RATE_MAX_PER_MINUTE=30
UPLOAD_MAX_MB=5
PLATFORM_COMMISSION_PERCENT=15
TZ_OFFSET_HOURS=2
DELIVERY_OFFER_TIMEOUT_SECONDS=45
DELIVERY_RADIUS_KM=8
DELIVERY_MAX_ACTIVE=3
DELIVERY_BASE_FEE_RWF=500
DELIVERY_PER_KM_FEE_RWF=200
DELIVERY_MIN_FEE_RWF=800
DELIVERY_ROAD_FACTOR=1.3
DELIVERY_DRIVER_SHARE_PERCENT=100
DELIVERY_LATE_PENALTY_PERCENT=20
OWNER_MAX_WITHDRAWAL_RWF=500000
OWNER_MAX_WEEKLY_RWF=2000000
OWNER_RESERVE_PERCENT=10
OWNER_DESTINATION_COOLDOWN_HOURS=48
OWNER_SWEEP_ENABLED=true
OWNER_SWEEP_WEEKDAY=5
OWNER_SWEEP_HOUR=9
OWNER_SWEEP_MIN_RWF=5000
ADMIN_OTP_TTL_MINUTES=5
ADMIN_IDLE_TIMEOUT_MINUTES=30

# ---------------------------------------------------------------------------
# Advanced (optional). Every value below is the built-in default, so the
# project runs the same with or without them; listed here so all settings
# the backend reads are in one place.
# ---------------------------------------------------------------------------
# Admin
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_RATE_WINDOW_MS=60000
ADMIN_RATE_MAX=300
PAYOUT_FEE_RWF=0
LARGE_MONEY_ACTION_RWF=50000
TEAM_INVITE_VALID_HOURS=72
REFUND_EXPECTED_HOURS=24


# Search radius for kitchens (km)
DEFAULT_RADIUS_KM=5
MAX_RADIUS_KM=50
FEED_RADIUS_KM=10
NEAR_YOU_RADIUS_KM=5

# Maps / geocoding (free OpenStreetMap services when no Google key is set)
GOOGLE_MAPS_TIMEOUT_MS=4000
GOOGLE_MAPS_CACHE_TTL_SECONDS=600
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRY=rw
GEOCODER_TIMEOUT_MS=6500

# Delivery dispatch details
DELIVERY_LOCATION_MAX_AGE_MINUTES=60
DELIVERY_MAX_OFFER_RECIPIENTS=50
DELIVERY_PICKUP_GRACE_MINUTES=15
DELIVERY_PICKUP_WARNING_MINUTES=10
DELIVERY_PICKUP_REASSIGN_MINUTES=30
DELIVERY_DISPATCH_TICK_SECONDS=60
DELIVERY_PLATFORM_MAX_KM=30

# Scheduled orders, specials and offer days
SCHEDULE_MIN_LEAD_MINUTES=45
SCHEDULE_MAX_DAYS_AHEAD=7
SCHEDULE_READY_WINDOW_MINUTES=60
SPECIAL_MAX_DAYS_AHEAD=14
OFFER_MAX_DAYS_AHEAD=60
OFFER_MAX_UPCOMING=3
OFFER_REMINDER_HOUR=9

# Uploads (private = vendor/driver documents)
UPLOAD_DOC_MAX_MB=10
