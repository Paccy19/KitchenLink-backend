# KitchenLink — Docker Compose settings for the production stack.
# Copy to deploy/.env on the server (gitignored) and fill in every CHANGE_ME.
#
# Passwords end up inside database URLs: use letters and digits only, e.g.
#   openssl rand -hex 32
# (PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_}))

# --- Domains (DNS A records must point at the VPS) -------------------------
SITE_DOMAIN=igikoni.online
WWW_DOMAIN=www.igikoni.online
API_DOMAIN=api.igikoni.online
# Let's Encrypt account / expiry notices
ACME_EMAIL=CHANGE_ME@example.com

# --- Website build (baked into the frontend image at build time) ----------
VITE_API_BASE_URL=https://api.igikoni.online/api/v1
VITE_UPLOADS_ORIGIN=https://api.igikoni.online
VITE_API_TIMEOUT=8000
# Optional CARTO basemap key (restrict it to igikoni.online in the CARTO console)
VITE_CARTO_API_KEY=

# --- MongoDB (source of truth) --------------------------------------------
# Root user: administration and backups only.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME
# Application user: created automatically on the first start (empty volume).
MONGO_APP_DB=online_food_kitchen
MONGO_APP_USER=kitchenlink
MONGO_APP_PASSWORD=CHANGE_ME

# --- PostgreSQL (read-only mirror of MongoDB) ------------------------------
POSTGRES_DB=online_food_kitchen
POSTGRES_USER=kitchenlink
POSTGRES_PASSWORD=CHANGE_ME
